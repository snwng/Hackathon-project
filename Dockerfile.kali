FROM kalilinux/kali-rolling:latest
ENV DEBIAN_FRONTEND=noninteractive
RUN printf '%s\n' \
    'deb http://kali.download/kali kali-rolling main contrib non-free non-free-firmware' \
    > /etc/apt/sources.list \
    && rm -f /etc/apt/sources.list.d/* \
    && printf '%s\n' \
    'Acquire::Retries "10";' \
    'Acquire::http::Timeout "15";' \
    'Acquire::https::Timeout "15";' \
    'Acquire::ForceIPv4 "true";' \
    > /etc/apt/apt.conf.d/99network-retries \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    ca-certificates \
    python3 \
    python3-pip \
#    kali-linux-headless \
    nmap \
    gobuster \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace

COPY requirements.txt /tmp/requirements.txt
RUN python3 -m pip install --break-system-packages --no-cache-dir -r /tmp/requirements.txt

COPY . /workspace

CMD ["bash", "-lc", "python3 -m pentest_agent demo --iterations 5"]
